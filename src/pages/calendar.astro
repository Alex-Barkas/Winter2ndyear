---
import BaseLayout from '../layouts/BaseLayout.astro';
import terms from '../data/terms.js';

// Replaces the old runtime multi-<script>-tag merge in calendar.html: build
// the courseCode -> term map and per-term termRanges server-side, then merge
// courses the same way todo.astro does (fall2026's other fields + flattened
// cross-term courses array), matching today's behavior exactly.
const courseTermMap: Record<string, string> = {};
for (const [term, data] of Object.entries(terms)) {
    for (const course of data.courses || []) {
        courseTermMap[course.code] = term;
    }
}

const termRanges = {
    winter2026: terms.winter2026.termRange,
    summer2026: terms.summer2026.termRange,
    fall2026: terms.fall2026.termRange,
};

const mergedCourses = [
    ...terms.winter2026.courses,
    ...terms.summer2026.courses,
    ...terms.fall2026.courses,
];
const studentData = { ...terms.fall2026, courses: mergedCourses };

// calendar-page.js's buildCourseOptgroupsHtml() builds the event modal's
// course dropdown from these three globals directly, same as todo-page.js.
const coursesWinter2026 = terms.winter2026.courses;
const coursesSummer2026 = terms.summer2026.courses;
const coursesFall2026 = terms.fall2026.courses;
---

<BaseLayout
    title="Calendar - Notes."
    favicon="/assets/maple_leaf_favicon.png"
    extraCss={["/css/list-ui.css?v=1", "/css/modal.css?v=1", "/css/calendar.css?v=1"]}
>
    <Fragment slot="head">
        <script is:inline define:vars={{ studentData, courseTermMap, termRanges, coursesWinter2026, coursesSummer2026, coursesFall2026 }}>
            window.STUDENT_DATA = studentData;
            window.__courseTermMap = courseTermMap;
            window.__termRanges = termRanges;
            window.__coursesWinter2026 = coursesWinter2026;
            window.__coursesSummer2026 = coursesSummer2026;
            window.__coursesFall2026 = coursesFall2026;
        </script>
    </Fragment>

    <main class="container">
        <header>
            <a href="/" class="back-link">← Back to Dashboard</a>
            <h1>Calendar</h1>
            <p class="subtitle">Every course, every deadline, every to-do — one place.</p>
        </header>

        <div class="cal-toolbar">
            <div id="cal-controls" class="list-controls"></div>
            <button id="cal-add-btn" class="cal-add-btn" type="button">+ Add Event</button>
        </div>

        <div class="cal-page-layout">
            <div class="cal-main-panel">
                <div id="cal-month-view">
                    <div class="cal-month-header">
                        <button id="cal-prev-month" class="cal-nav-btn" type="button" aria-label="Previous month">&lt;</button>
                        <h2 id="cal-month-label">—</h2>
                        <button id="cal-next-month" class="cal-nav-btn" type="button" aria-label="Next month">&gt;</button>
                    </div>
                    <div class="cal-grid-header">
                        <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
                    </div>
                    <div id="cal-grid" class="cal-grid"></div>
                </div>
                <div id="cal-agenda-view" class="list-grid hidden"></div>
            </div>

            <aside class="cal-side-panel">
                <div class="cal-side-card" id="cal-unscheduled-card" data-date="" data-tray="true">
                    <h3>Unscheduled</h3>
                    <div id="cal-tray-list" class="cal-tray-list"></div>
                </div>
                <div class="cal-side-card" id="cal-detail-card">
                    <div id="cal-day-detail"></div>
                </div>
            </aside>
        </div>
    </main>

    <!-- Add / Edit Event Modal -->
    <div id="event-modal" class="modal-overlay" hidden>
        <div class="modal-content">
            <h3 id="event-modal-title">Add Event</h3>

            <div class="input-group">
                <label>Type</label>
                <select id="event-type" class="input-field">
                    <option value="assignment">Assignment / Exam</option>
                    <option value="todo">To-do</option>
                </select>
            </div>
            <div class="input-group">
                <label>Title</label>
                <input type="text" id="event-title" class="input-field" placeholder="e.g. Lab 4 Report">
            </div>
            <div class="input-group">
                <label>Course</label>
                <select id="event-course" class="input-field">
                    <option value="Personal">Personal</option>
                    <!-- Course options injected per term -->
                </select>
            </div>
            <div class="input-group" id="event-category-group">
                <label>Category</label>
                <select id="event-category" class="input-field">
                    <option value="ASSIGNMENT">Assignment</option>
                    <option value="LAB">Lab</option>
                    <option value="TUTORIAL">Tutorial</option>
                    <option value="QUIZ">Quiz</option>
                    <option value="MIDTERM">Midterm</option>
                    <option value="FINAL">Final</option>
                    <option value="HOMEWORK">Homework</option>
                    <option value="REMINDER">Reminder</option>
                </select>
            </div>
            <div class="input-group" id="event-urgency-group">
                <label>Urgency</label>
                <select id="event-urgency" class="input-field">
                    <option value="1">1 - Trivial</option>
                    <option value="2">2 - Low</option>
                    <option value="3" selected>3 - Normal</option>
                    <option value="4">4 - High</option>
                    <option value="5">5 - Critical</option>
                </select>
            </div>
            <div class="input-group">
                <label>Date</label>
                <input type="date" id="event-date" class="input-field">
            </div>
            <div class="input-group" id="event-time-group">
                <label>Time</label>
                <input type="time" id="event-time" class="input-field">
            </div>

            <div class="modal-actions">
                <button type="button" id="event-delete-btn" class="danger hidden">Delete</button>
                <button type="button" id="event-cancel-btn" class="secondary">Cancel</button>
                <button type="button" id="event-save-btn">Save</button>
            </div>
        </div>
    </div>

    <script type="module" src="/js/calendar-page.js?v=1" is:inline></script>
</BaseLayout>
